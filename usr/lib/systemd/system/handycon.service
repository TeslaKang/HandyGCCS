[Unit]
Description=Handheld Game Console Controller Service
# Start before the display manager so the controller/keyboard devices are
# grabbed and hidden before gamescope (libinput) opens them.
After=systemd-udev-trigger.service
Before=display-manager.service
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=5s
ExecStart=/usr/bin/nice --15 /usr/bin/handycon

[Install]
WantedBy=multi-user.target
